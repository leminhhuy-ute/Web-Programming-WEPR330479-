# Set these variables in the process environment; Spring Boot does not load this file automatically.
MAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
MAIL_FROM=your-verified-sender@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true

# Render + Aiven (NEW empty database; do not commit actual credentials)
# cloud-demo adds sample accounts once, only if the users table is empty.
# For real use omit cloud-demo and provision accounts separately.
SPRING_PROFILES_ACTIVE=cloud,cloud-demo
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=avnadmin
DB_PASSWORD=SET_IN_RENDER_DASHBOARD_ONLY
SESSION_COOKIE_SECURE=true
