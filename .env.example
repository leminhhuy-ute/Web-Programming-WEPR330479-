# Set these variables in the process environment; Spring Boot does not load this file automatically.
MAIL_ENABLED=false
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=2525
MAIL_USERNAME=your-mailjet-api-key
MAIL_PASSWORD=your-mailjet-secret-key
# Must be an address on a domain you control and have authenticated with Mailjet.
MAIL_FROM=notifications@your-domain.example
MAIL_AUTH=true
MAIL_STARTTLS=true

# Production Render + Aiven (NEW empty database; do not commit actual credentials)
# Use cloud only for real data; adding cloud-demo creates sample accounts on an empty DB.
SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=avnadmin
DB_PASSWORD=SET_IN_RENDER_DASHBOARD_ONLY
SESSION_COOKIE_SECURE=true
